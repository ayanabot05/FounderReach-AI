# =========================================================================
# FounderReach AI .gitignore
# =========================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json
*credentials*.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
build/

# Testing & Caches
.pytest_cache/
.pytest-*/
.coverage
.coverage.*
htmlcov/
.benchmarks/
.jest_cache/
.tox/
.nox/
.agents/

# Local databases and runtime data
data/
backend/data/
outputs/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Node.js & Vite build caches
node_modules/
.npm/
.next/
coverage/
*.tsbuildinfo
frontend/node_modules/
dist/
frontend/dist/

# Test screenshots and temporary artifacts
*.png
*.jpg
*.jpeg
*.cjs
*.log
logs/
reports/generated/
reports/tmp/

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
