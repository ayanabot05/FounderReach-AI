# ==============================================================================
# FounderReach AI — Production Environment Configuration (.env)
# ==============================================================================

# Master Super-Admin Credentials (Auto-Bootstrapped on Startup)
ADMIN_EMAIL=admin@founderreach.ai
ADMIN_PASSWORD=ChangeThisToAStrongSecretPassword2026!

# JWT Token Security (Role-based claims for Auth and Admin APIs)
JWT_SECRET_KEY=change_this_to_a_random_64_character_hex_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe Payment & Subscription Processing
# Leave keys blank for automatic Sandbox Mock Checkout mode
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase Cloud Database & Storage (Optional, falls back to local SQLite if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_ENABLED=false

# Performance & Security Gateways
DATABASE_PATH=data/founderreach.db
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60

# Optional: Google Gemini API (for semantic explanations if enabled)
# When unset, FounderReach AI uses deterministic zero-cost NLP extraction engine
GEMINI_API_KEY=

# Discovery Source Configurations
# Hacker News: Public Algolia API (Free, enabled by default)
HN_ENABLED=true
HN_API_BASE=https://hn.algolia.com/api/v1

# Reddit Connector (Commercial API integration)
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FounderReach/1.0

# Opportunity scoring threshold (0-100)
DEFAULT_SCORE_THRESHOLD=75
