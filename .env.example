# FounderReach AI Environment Configuration

# Optional: Google Gemini API (for enhanced semantic explanations if available)
# When unset, FounderReach AI uses its deterministic high-precision NLP extraction engine at ₹0 cost.
GEMINI_API_KEY=

# Budget & Financial Safety Controls (INR)
# CEO-authorized new spend is hard-set to INR 0 in code during M1.
# These historical thresholds do not authorize any paid call.
BUDGET_TARGET_INR=600.00
BUDGET_HARD_CEILING_INR=1000.00

# Discovery Source Configurations
# Hacker News: Public Algolia API (Free, enabled by default)
HN_ENABLED=true
HN_API_BASE=https://hn.algolia.com/api/v1

# Reddit: Disabled by default per CEO directive until commercial-use authorization is obtained
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FounderReach/1.0

# Supabase project
SUPABASE_ENABLED=false
SUPABASE_URL=https://xsumvcqeqknshjwdnypy.supabase.co

# Public frontend key (only if needed)
SUPABASE_ANON_KEY=

# Backend-only secret key (or service role key)
SUPABASE_SECRET_KEY=

# PostgreSQL connection string (optional)
DATABASE_URL=

# SQLite fallback (used automatically if SUPABASE keys are unset)
DATABASE_PATH=data/founderreach.db

# Opportunity filtering (0-100)
DEFAULT_SCORE_THRESHOLD=75
